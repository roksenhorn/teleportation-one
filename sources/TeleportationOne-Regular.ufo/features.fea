@KERN_Y = [Y Yacute Ycircumflex Ydieresis Ygrave y yacute ycircumflex ydieresis ygrave];
@KERN_Z = [Z Zacute Zcaron Zdotaccent z zacute zcaron zdotaccent];

feature liga {
  sub less hyphen hyphen greater by arrowboth;
  sub less hyphen greater by arrowboth;
  sub arrowleft arrowright by arrowboth;
  sub less hyphen by arrowleft;
  sub hyphen greater by arrowright;
} liga;

